# Supabase — from your project's API settings.
# Points at the SAME Supabase project as trace-ugc-tracker for now: the
# research_creators / research_videos / research_video_segments tables and all
# existing data live there (migration 0027 in the tracker, mirrored here as
# supabase/migrations/0001_research.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scrape Creators — server-only. NEVER expose to the browser.
# Profile + video scraping for both Instagram and TikTok. Get a key at
# https://scrapecreators.com. Billed per request; a profile scrape costs one
# call for the profile plus one per page of videos (~12 IG / ~10 TikTok).
SCRAPECREATORS_API_KEY=your-scrapecreators-api-key

# Shared secret used to authorize POST /api/jobs/research requests.
CRON_SECRET=generate-a-long-random-string

# Supabase Management API personal access token, from
# https://supabase.com/dashboard/account/tokens
# Server-only, and NOT interchangeable with the service-role key above.
# Only needed to run migrations:
#   node scripts/apply-migration.mjs supabase/migrations/<file>.sql
# The app itself runs fine without it.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# Optional — worker transcription fallback when WhisperX isn't installed.
OPENAI_API_KEY=
